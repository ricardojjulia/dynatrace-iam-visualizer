{
  "name": "server",
  "version": "0.1.0",
  "description": "Backend server for Dynatrace IAM Policy Visualizer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "generate-types": "openapi-typescript DT-Account-MGMT-API.json -o src/generated-types.ts",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "openapi-typescript": "^6.7.2",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
